# Copy to settings.toml (gitignored). Never put secrets in chat or git.
# Bot process needs only bot_token. api_id / api_hash belong on the
# local telegram-bot-api server binary, not here.

bot_token = ""
api_base = "https://api.telegram.org"
data_dir = "data"
poll_timeout = 25
worker_timeout = 600
# Optional operator-wide Netscape cookies file (fallback).
# People in Telegram can also send cookie.txt as a document.
# Or set TG_COOKIES. Never commit the file.
# cookies = "cookies.txt"
